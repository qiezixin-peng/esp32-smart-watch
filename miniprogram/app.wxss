/* app.wxss - 全局样式 v29e（白色背景 + 浅灰卡片，边界清晰） */
page {
  background: #ffffff;
  color: #1c2333;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 28rpx 28rpx 80rpx;
}

/* 浅灰卡片：白底上用浅灰块 + 明显边框 + 阴影，边界清晰 */
.card {
  background: #f5f7fb;
  border: 1rpx solid rgba(28, 40, 70, 0.12);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 14rpx 40rpx rgba(28, 48, 100, 0.12);
}

/* 卡片标题：左侧 6rpx 渐变竖条装饰 */
.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2333;
  margin-bottom: 24rpx;
}
.card-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  margin-right: 14rpx;
  background: linear-gradient(180deg, #5b8cff, #3ddbd6);
}

/* 主按钮：蓝青渐变 + 圆角 + 投影 */
.btn-primary {
  background: linear-gradient(135deg, #5b8cff 0%, #3ddbd6 100%);
  color: #ffffff;
  border-radius: 18rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 26rpx rgba(77, 146, 255, 0.28);
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { opacity: 0.5; box-shadow: none; }

/* 次按钮：浅灰玻璃 */
.btn {
  background: #ffffff;
  color: #1c2333;
  border: 1rpx solid rgba(28, 40, 70, 0.14);
  border-radius: 18rpx;
  font-size: 26rpx;
}
.btn::after { border: none; }
.btn[disabled] { opacity: 0.5; }

/* 通用提示文字 */
.tip { color: #7a8499; text-align: center; padding: 48rpx 0; line-height: 1.8; font-size: 26rpx; }
