<!-- pages/health/health.wxml - 健康报表（v29c 视觉升级） -->
<view class="container">
  <!-- 指标切换胶囊 -->
  <view class="metric-bar">
    <view
      wx:for="{{metrics}}"
      wx:key="key"
      class="metric {{activeIndex === index ? 'metric-active' : ''}}"
      data-idx="{{index}}"
      bindtap="onTapMetric"
    >{{item.name}}</view>
  </view>

  <!-- 最新值 -->
  <view class="card latest-card" wx:if="{{!empty}}">
    <view class="latest-label">最新 {{activeMetric.name}}</view>
    <view wx:for="{{records}}" wx:key="ts">
      <block wx:if="{{index === records.length - 1}}">
        <view class="latest-wrap">
          <text class="latest-v">{{item[activeMetric.key]}}</text>
          <text class="latest-unit">{{activeMetric.unit}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 图表 -->
  <view class="card chart-card">
    <view class="chart-head">
      <view class="chart-title">{{activeMetric.name}}趋势</view>
      <view wx:if="{{!loading && !empty}}" class="count">{{countText}}</view>
    </view>
    <canvas type="2d" id="chart" class="chart"></canvas>
    <view wx:if="{{loading}}" class="tip">加载中...</view>
    <view wx:elif="{{empty}}" class="tip">暂无数据，请确认云函数已采集</view>
  </view>
</view>
