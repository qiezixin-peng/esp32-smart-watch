/* pages/index/index.wxss - v29e 边界清晰 */
.card-head { display: flex; align-items: center; justify-content: space-between; }
.update-time {
  font-size: 22rpx;
  color: #7a8499;
  background: #ffffff;
  border: 1rpx solid rgba(28, 40, 70, 0.12);
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}

.grid { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
}
.cell-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 20rpx rgba(28, 48, 100, 0.14);
}
.ic-amber  { background: linear-gradient(135deg, #ffb454, #ff8a5c); }
.ic-cyan   { background: linear-gradient(135deg, #4fb8ff, #3ddbd6); }
.ic-violet { background: linear-gradient(135deg, #9d8cff, #7a6cf0); }
.ic-coral  { background: linear-gradient(135deg, #ff7a8a, #ff5f7e); }
.ic-green  { background: linear-gradient(135deg, #4ed9a6, #2fbf8f); color: #ffffff; font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx; }

.cell-v { font-size: 40rpx; font-weight: 700; color: #1c2333; line-height: 1.1; }
.unit { font-size: 22rpx; font-weight: 400; color: #7a8499; margin-left: 4rpx; }
.cell-k { font-size: 22rpx; color: #7a8499; margin-top: 8rpx; }

/* 功能入口：浅灰块 + 明显边框 */
.entry {
  display: flex;
  align-items: center;
  background: #f5f7fb;
  border: 1rpx solid rgba(28, 40, 70, 0.12);
  border-radius: 28rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 12rpx 36rpx rgba(28, 48, 100, 0.10);
}
.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(28, 48, 100, 0.16);
}
.ec-blue   { background: linear-gradient(135deg, #5b8cff, #3ddbd6); }
.ec-green  { background: linear-gradient(135deg, #35d0a0, #8fd96a); }
.ec-purple { background: linear-gradient(135deg, #a78bfa, #f472b6); }
.entry-text { flex: 1; }
.entry-title { font-size: 30rpx; font-weight: 600; color: #1c2333; }
.entry-desc { font-size: 22rpx; color: #7a8499; margin-top: 6rpx; }
.entry-arrow { color: #b6bdc9; font-size: 44rpx; font-weight: 300; }
