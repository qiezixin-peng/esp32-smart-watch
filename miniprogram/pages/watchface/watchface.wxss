/* pages/watchface/watchface.wxss - v29d 白色适配 */
.desc { color: #7a8499; font-size: 24rpx; line-height: 1.8; margin-bottom: 28rpx; }

/* 预览：模拟手表屏幕，保留深色 + 浅页面下的浅灰描边 */
.preview {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 32rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #0b1220;
  border: 2rpx solid rgba(28, 40, 70, 0.12);
  box-shadow: 0 16rpx 40rpx rgba(28, 48, 100, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-img { width: 100%; height: 100%; }
.preview-empty { display: flex; flex-direction: column; align-items: center; }
.preview-plus {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b8cff, #3ddbd6);
  color: #ffffff;
  font-size: 56rpx;
  line-height: 84rpx;
  text-align: center;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(77, 146, 255, 0.35);
}
.preview-text { color: #8d99b3; font-size: 26rpx; }

.row { display: flex; justify-content: center; }
.btn { margin: 0 12rpx; font-size: 26rpx; padding: 0 36rpx; }

.status { margin-top: 30rpx; font-size: 26rpx; text-align: center; line-height: 1.7; }
.status-ok { color: #10b981; }
.status-err { color: #e5484d; }
.last-at { margin-top: 12rpx; font-size: 22rpx; color: #7a8499; text-align: center; }
.hidden-canvas { position: fixed; left: -2000px; top: 0; }
